# Copy to .env (already gitignored) and fill in real values.

# Required by agents/ops_agent/agent.py - it calls the Anthropic API
# directly, independent of any Claude client/session.
ANTHROPIC_API_KEY=

# Existing Hedera vars referenced elsewhere in this project (docker compose
# warns if these are unset - harmless for local dev, needed for real
# Hedera topic writes).
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=

# Asterisk SIP secret used by configs/asterisk/*.conf via docker-compose.
# Generate your own, e.g.: python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
ASTERISK_SIP_SECRET=
